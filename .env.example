# 이 파일을 .env.local로 복사한 뒤 실제 값을 채우세요. (.env.local은 git에 올라가지 않습니다)
# cp .env.example .env.local
#
# 같은 값을 Vercel → Settings → Environment Variables에도 등록하세요.

# 공공데이터포털(data.go.kr) 서비스 키 — 서버 전용. NEXT_PUBLIC_ 붙이지 말 것
DATA_GO_KR_KEY=

# 카카오맵 JavaScript 키 — 브라우저에 노출되는 키. 카카오 콘솔에서 허용 도메인 제한 필수
NEXT_PUBLIC_KAKAO_MAP_KEY=
